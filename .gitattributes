# 统一换行符为 LF,避免跨平台协作时整文件 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.exe   binary
*.dll   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.db    binary
*.sqlite3 binary

# 锁文件与生成物在 diff 中折叠
uv.lock             linguist-generated=true
package-lock.json   linguist-generated=true
