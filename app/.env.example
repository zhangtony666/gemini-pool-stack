# Copy to .env; start with: uv run --env-file .env image-verifier serve
IV_BACKEND=mock
IV_DB_PATH=data/verifier.sqlite3
IV_API_KEY=replace-with-a-long-random-token
IV_ADMIN_KEY=replace-with-a-different-long-random-token
IV_HOST=127.0.0.1
IV_PORT=8083
IV_WORKERS=2
IV_CONCURRENCY=2
# Local demo budgets, NOT verified provider quotas.
IV_RPM=60
IV_RPH=600
IV_MAX_PENDING=1000
IV_MAX_ATTEMPTS=2
IV_ATTEMPT_TIMEOUT=20
IV_LEASE_SECONDS=30
IV_CACHE_TTL=86400
# Needed only for IV_BACKEND=gemini. No default production model is assumed.
# IV_MODEL=your-validated-model-id
# GEMINI_API_KEY=your-key
# Needed only for IV_BACKEND=web. IV_WEB_BASE_URL points at the local gateway
# that fronts the session pool; keep it on a different port than IV_PORT.
# IV_WEB_BASE_URL=http://127.0.0.1:8084/v1
# IV_WEB_API_KEY=the-gateway-api-key
# IV_MODEL=gemini-3.6-flash
