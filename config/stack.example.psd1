# ═══════════════════════════════════════════════════════════════════════
#  image-verifier-stack 配置文件
# ═══════════════════════════════════════════════════════════════════════
#
#  这是唯一需要修改的文件。所有脚本都从这里读路径、端口和密钥。
#
#  首次使用:直接跑 `pwsh -File scripts/stack.ps1 doctor` 看自检结果,
#  它会告诉你缺什么、该填哪里。
#
# ═══════════════════════════════════════════════════════════════════════

@{

    # ── 网关程序位置 ────────────────────────────────────────────────────
    #
    #  留空 = 自动探测以下位置(按顺序):
    #    1. 仓库根目录下        ./gemini-web2api-go.exe
    #    2. 仓库根目录下        ./bin/gemini-web2api-go.exe
    #    3. 同级的 gemini-gateway 目录
    #
    #  都没找到时,填完整路径,例如:
    #    GatewayExe = 'D:/tools/gateway/gemini-web2api-go.exe'
    #
    GatewayExe = ''

    # ── 端口 ───────────────────────────────────────────────────────────
    #
    #  网关和业务后端不能同端口。
    #  8080 / 8081 / 3000 / 5000 常被其它软件占用,已避开。
    #
    GatewayPort  = 8084
    VerifierPort = 8083

    # ── 密钥 ───────────────────────────────────────────────────────────
    #
    #  两项都留空即可。首次启动时脚本会自动生成 / 读取,并写回本文件。
    #  写回后本文件的注释会丢失,属于正常现象。
    #
    AdminToken    = ''
    GatewayApiKey = ''

    # ── 出口代理 ───────────────────────────────────────────────────────
    #
    #  gemini.google.com 在多数网络环境下无法直连,需要一个 HTTP 代理。
    #  常见本地代理端口:
    #    Clash / Mihomo / Clash Verge      7890
    #    V2RayN                            10809
    #    sing-box                          2080
    #
    #  留空 = 不预置代理,之后在管理面板的「代理池」页面手动添加。
    #  填写 = 每次启动时把该代理导入池中(按 URL 去重,不会重复添加)。
    #
    ProxySeed = 'http://127.0.0.1:7890'

    # ── 运行行为 ───────────────────────────────────────────────────────
    GatewayHidden    = $true    # $true = 网关后台运行;$false = 显示日志窗口
    OpenAdminOnStart = $false   # 启动后自动打开管理面板
}
